# ─── Site ──────────────────────────────────────────────────────────────────────
# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://bluegou.com

# ─── Email / Contact Form ──────────────────────────────────────────────────────
# Resend API key — obtain from https://resend.com/api-keys
# Must have bluegou.com verified as a sending domain in Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destination address for contact-form submissions
CONTACT_EMAIL=storage@bluegou.com

# ─── Analytics ─────────────────────────────────────────────────────────────────
# Plausible domain — leave empty to disable the analytics script
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bluegou.com
